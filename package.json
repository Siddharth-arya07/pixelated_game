{
  "name": "nostalgia-3am",
  "private": true,
  "version": "0.1.0",
  "description": "A first-person PS1-style 3:00 a.m. slice-of-life game built with Three.js + three-psx.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "rooms": "wrangler dev --config cloudflare/wrangler.toml --port 1999",
    "rooms:deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "site:deploy": "vite build && sh cloudflare/pages/deploy.sh"
  },
  "dependencies": {
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
